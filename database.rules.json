{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_.]{0,30}$/)"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "website": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "photo": {
          ".validate": "newData.val() === '' || (newData.isString() && newData.val().matches(/^https:\\/\\//))"
        },
        "cover": {
          ".validate": "newData.val() === '' || (newData.isString() && newData.val().matches(/^https:\\/\\//))"
        },
        "profileSetupComplete": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "profiles": {
      ".read": "auth != null",
      ".indexOn": ["usernameLower", "nameLower", "firstNameLower", "lastNameLower"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_.]{0,30}$/)"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "website": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "photo": {
          ".validate": "newData.val() === '' || (newData.isString() && newData.val().matches(/^https:\\/\\//))"
        },
        "cover": {
          ".validate": "newData.val() === '' || (newData.isString() && newData.val().matches(/^https:\\/\\//))"
        },
        "profileSetupComplete": {
          ".validate": "newData.isBoolean()"
        },
        "uid": {
          ".validate": "newData.val() === $uid"
        }
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && $username.matches(/^[a-z0-9_.]{3,30}$/)"
      }
    },
    "friendRequests": {
      "$recipient": {
        ".read": "auth != null && auth.uid === $recipient",
        "$requester": {
          ".read": "auth != null && (auth.uid === $recipient || auth.uid === $requester)",
          ".write": "auth != null && ((auth.uid === $requester && $requester !== $recipient && ((!data.exists() && newData.child('senderId').val() === auth.uid) || !newData.exists())) || (auth.uid === $recipient && !newData.exists()))"
        }
      }
    },
    "sentRequests": {
      "$sender": {
        ".read": "auth != null && auth.uid === $sender",
        "$receiver": {
          ".write": "auth != null && $sender !== $receiver && (auth.uid === $sender || (auth.uid === $receiver && !newData.exists()))",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        "$friendUid": {
          ".write": "auth != null && $uid !== $friendUid && ((!newData.exists() && (auth.uid === $uid || auth.uid === $friendUid)) || (!data.exists() && ((auth.uid === $uid && root.child('friendRequests').child($uid).child($friendUid).exists()) || (auth.uid === $friendUid && root.child('friendRequests').child($friendUid).child($uid).exists()))))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "posts": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "authorId"],
      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.child('authorId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['authorId', 'createdAt']) && newData.child('authorId').val() === auth.uid && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 2000))",
        "images": {
          ".validate": "newData.numChildren() <= 10",
          "$index": {
            ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\//)"
          }
        }
      }
    },
    "postReactions": {
      "$postId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().matches(/^(Like|Love|Laugh|Wow|Sad|Angry)$/)"
        }
      }
    },
    "comments": {
      "$postId": {
        ".read": "auth != null",
        ".indexOn": ["createdAt", "parentCommentId"],
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || data.child('authorId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['authorId', 'createdAt']) && newData.child('authorId').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 1000"
        }
      }
    },
    "commentLikes": {
      "$commentId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": "auth != null",
          ".validate": "newData.val() === true"
        }
      }
    },
    "stories": {
      "$uid": {
        "public": {
          ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).val() === true)",
          ".indexOn": ["expiresAt"],
          "$storyId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['mediaRef', 'type', 'audience', 'createdAt', 'expiresAt']) && newData.child('mediaRef').isString() && newData.child('mediaRef').val().matches(/^https:\\/\\//) && newData.child('type').val().matches(/^(image|video)$/) && newData.child('expiresAt').isNumber() && (!newData.child('label').exists() || (newData.child('label').isString() && newData.child('label').val().length <= 80))"
          }
        },
        "closeFriends": {
          ".read": "auth != null && (auth.uid === $uid || root.child('closeFriends').child($uid).child(auth.uid).val() === true)",
          ".indexOn": ["expiresAt"],
          "$storyId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['mediaRef', 'type', 'audience', 'createdAt', 'expiresAt']) && newData.child('mediaRef').isString() && newData.child('mediaRef').val().matches(/^https:\\/\\//) && newData.child('type').val().matches(/^(image|video)$/) && newData.child('expiresAt').isNumber() && (!newData.child('label').exists() || (newData.child('label').isString() && newData.child('label').val().length <= 80))"
          }
        }
      }
    },
    "storyViews": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$storyId": {
          ".write": "auth != null && auth.uid === $owner && !newData.exists()",
          "$viewer": {
            ".read": "auth != null && auth.uid === $viewer",
            ".write": "auth != null && auth.uid === $viewer && $viewer !== $owner",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "storyReactions": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$storyId": {
          ".write": "auth != null && auth.uid === $owner && !newData.exists()",
          "$viewer": {
            ".write": "auth != null && auth.uid === $viewer && $viewer !== $owner",
            ".validate": "newData.isString() && newData.val().matches(/^(Like|Love|Laugh)$/)"
          }
        }
      }
    },
    "closeFriends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true && root.child('friends').child($uid).child($friendUid).val() === true"
        }
      }
    },
    "chats": {
      "$chatId": {
        "members": {
          ".read": "auth != null && (!data.exists() || data.child(auth.uid).val() === true)",
          ".write": "auth != null && !data.exists() && newData.numChildren() === 2 && newData.child(auth.uid).val() === true && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && newData.child($chatId.replace(auth.uid, '').replace('_', '')).val() === true",
          "$memberUid": {
            ".validate": "newData.val() === true"
          }
        },
        "messages": {
          ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
          ".indexOn": ["timestamp"],
          "$messageId": {
            ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true && ((!data.exists() && newData.child('senderId').val() === auth.uid) || (data.child('senderId').val() === auth.uid && ((newData.exists() && now - data.child('timestamp').val() < 300000 && newData.child('timestamp').val() === data.child('timestamp').val() && newData.child('senderId').val() === data.child('senderId').val()) || (!newData.exists() && now - data.child('timestamp').val() < 300000))))",
            ".validate": "newData.hasChildren(['senderId', 'type', 'timestamp']) && newData.child('type').val().matches(/^(text|image|post|system|call)$/) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
          }
        },
        "lastMessage": {
          ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['text', 'senderId']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
        },
        "lastRead": {
          "$uid": {
            ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.isNumber()"
          }
        },
        "typing": {
          "$uid": {
            ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.isBoolean()"
          }
        },
        "unread": {
          "$uid": {
            ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
            ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('chats').child($chatId).child('members').child(auth.uid).val() === true)",
          ".validate": "newData.isString() && $chatId.contains($uid) && $chatId.contains(newData.val())"
        }
      }
    },
    "messageReactions": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
        "$messageId": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.val() === 'heart'"
          }
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["createdAt", "read"],
        "$notificationId": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || newData.child('read').val() === true)) || (!data.exists() && newData.child('senderId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['senderId', 'type', 'createdAt']) && newData.child('type').val().matches(/^(message|screenshot|friendRequest|friendAccepted|reaction|comment|reply|call)$/) && (!newData.child('body').exists() || (newData.child('body').isString() && newData.child('body').val().length <= 200))"
        }
      }
    },
    "pushQueue": {
      ".read": false,
      "$pushId": {
        ".write": "auth != null && !data.exists() && newData.child('fromUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['toUid', 'fromUid', 'type', 'title', 'body', 'createdAt']) && newData.child('toUid').isString() && newData.child('type').val().matches(/^(message|screenshot|call)$/) && newData.child('title').isString() && newData.child('title').val().length <= 80 && newData.child('body').isString() && newData.child('body').val().length <= 160"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tokenId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length < 4096"
        }
      }
    },
    "callLogs": {
      "$callId": {
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('callerId').val() === auth.uid) || data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(ringing|accepted|declined|missed|cancelled|ended)$/)"
        }
      }
    },
    "callRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".read": "auth != null && (auth.uid === $uid || data.child('callerId').val() === auth.uid)",
          ".write": "auth != null && ((!data.exists() && auth.uid === newData.child('callerId').val() && newData.child('calleeId').val() === $uid) || data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(ringing|accepted|declined|missed|cancelled|ended)$/)"
          },
          "video": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "marketplaceItems": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "ownerId"],
      "$itemId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || data.child('ownerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['ownerId', 'title', 'createdAt']) && newData.child('ownerId').val() === auth.uid && newData.child('title').isString() && newData.child('title').val().length <= 80"
      }
    }
  }
}
