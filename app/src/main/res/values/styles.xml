<resources>
    <style name="Title"><item name="android:fontFamily">sans</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">24sp</item><item name="android:textStyle">bold</item></style>
    <style name="Heading"><item name="android:fontFamily">sans</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="Body"><item name="android:fontFamily">sans</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">14sp</item></style>
    <style name="Meta"><item name="android:fontFamily">sans</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">11sp</item></style>
    <style name="TealButton"><item name="android:fontFamily">sans</item><item name="android:background">@drawable/rounded_teal</item><item name="android:textColor">@color/white</item><item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item><item name="android:textSize">14sp</item><item name="android:minHeight">0dp</item><item name="android:minWidth">0dp</item><item name="android:stateListAnimator">@null</item></style>
    <style name="LightButton"><item name="android:fontFamily">sans</item><item name="android:background">@drawable/rounded_light</item><item name="android:textColor">@color/text_primary</item><item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item><item name="android:minHeight">0dp</item><item name="android:minWidth">0dp</item><item name="android:stateListAnimator">@null</item></style>
    <style name="Input"><item name="android:fontFamily">sans</item><item name="android:background">@drawable/rounded_white</item><item name="android:textColor">@color/text_primary</item><item name="android:textColorHint">@color/text_secondary</item><item name="android:textSize">14sp</item><item name="android:padding">14dp</item></style>
    <style name="Avatar"><item name="android:layout_width">50dp</item><item name="android:layout_height">50dp</item><item name="android:background">@drawable/circle_teal</item><item name="android:gravity">center</item><item name="android:textColor">@color/white</item><item name="android:textStyle">bold</item><item name="android:textSize">17sp</item></style>
    <style name="Tab"><item name="android:layout_width">0dp</item><item name="android:layout_height">52dp</item><item name="android:layout_weight">1</item><item name="android:gravity">center</item><item name="android:padding">13dp</item><item name="android:tint">@color/text_secondary</item></style>
</resources>
