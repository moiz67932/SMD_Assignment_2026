<?xml version="1.0" encoding="utf-8"?>
<!-- Story viewer (11). Segments, header and label are filled by StoryViewerActivity. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/storyImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/storyReplyBar"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_dark"
        android:contentDescription="Story"
        android:scaleType="centerCrop" />

    <VideoView
        android:id="@+id/storyVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/storyReplyBar"
        android:layout_centerInParent="true"
        android:layout_margin="8dp"
        android:visibility="gone" />

    <!-- Tap left third = previous, elsewhere = next, hold = pause. -->
    <View
        android:id="@+id/storyTouch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/storyReplyBar" />

    <LinearLayout
        android:id="@+id/storySegments"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/storyAvatar"
            style="@style/Avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/storyAuthor"
                style="@style/Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/storyMeta"
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" />

        </LinearLayout>

        <ImageView
            android:id="@+id/storyMore"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="More options"
            android:padding="9dp"
            android:src="@drawable/ic_more"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Close"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:tint="@color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/storyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/rounded_white"
        android:gravity="center"
        android:padding="11dp"
        android:rotation="-5"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/storyReplyBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="#BB000000"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <EditText
            android:id="@+id/storyReplyInput"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/outline_white_pill"
            android:hint="Send message..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:paddingHorizontal="16dp"
            android:textColor="@color/white"
            android:textColorHint="#AAFFFFFF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/storyQuickLike"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="7dp"
            android:contentDescription="Like"
            android:src="@drawable/reaction_like" />

        <ImageView
            android:id="@+id/storyQuickLove"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Love"
            android:src="@drawable/reaction_love" />

        <ImageView
            android:id="@+id/storyQuickLaugh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Laugh"
            android:src="@drawable/reaction_laugh" />

    </LinearLayout>

</RelativeLayout>
