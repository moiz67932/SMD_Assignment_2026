<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Marketplace" />

        <ImageView
            android:id="@+id/searchButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Search"
            android:padding="9dp"
            android:src="@drawable/ic_search" />

        <ImageView
            android:id="@+id/chatsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Chats"
            android:padding="9dp"
            android:src="@drawable/ic_chat" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/homeTab"
            style="@style/Tab"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/friendsTab"
            style="@style/Tab"
            android:contentDescription="Friends"
            android:src="@drawable/ic_friends" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_marketplace"
                android:tint="@color/primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="9dp"
                android:background="@color/primary" />

        </LinearLayout>

        <ImageView
            android:id="@+id/notificationsTab"
            style="@style/Tab"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_notifications" />

        <ImageView
            android:id="@+id/menuTab"
            style="@style/Tab"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:id="@+id/sellButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_soft"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_edit" />

            <TextView
                style="@style/Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Sell"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_soft"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_grid" />

            <TextView
                style="@style/Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Categories"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <TextView
            style="@style/Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today's picks"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/ic_location"
            android:tint="@color/primary" />

        <TextView
            style="@style/Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Karachi · 40 km"
            android:textColor="@color/primary"
            android:textSize="10sp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/sampleMarketplaceScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="252dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="184dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/landscape" />

                        <TextView
                            style="@style/Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_margin="7dp"
                            android:background="@drawable/rounded_red"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="JUST LISTED"
                            android:textColor="@color/white"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <TextView
                        style="@style/Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Rs 45,000"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Road bike, 21-speed\nClifton"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="172dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/landscape_rose" />

                    <TextView
                        style="@style/Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Rs 8,500"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rattan armchair\nDHA Phase 6"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="238dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="172dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/landscape_blue" />

                    <TextView
                        style="@style/Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Rs 15,000"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Solid wood study desk\nGulshan"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="172dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/landscape_sand" />

                        <TextView
                            style="@style/Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_margin="7dp"
                            android:background="@drawable/rounded_red"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="JUST LISTED"
                            android:textColor="@color/white"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                    <TextView
                        style="@style/Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Rs 3,200"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ceramic plant pots, set of 3\nSaddar"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/marketplaceRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp" />

</LinearLayout>
