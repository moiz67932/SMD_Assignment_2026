<?xml version="1.0" encoding="utf-8"?>
<!-- A friend in Close friends: tap the row to add/remove (green star = on the list). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/closeFriendAvatar"
        style="@style/Avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/closeFriendName"
        style="@style/Heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/closeFriendStar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="Close friend"
        android:padding="8dp"
        android:src="@drawable/ic_star" />

</LinearLayout>
