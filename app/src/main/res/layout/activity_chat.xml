<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="5dp"
        android:paddingEnd="7dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/primary" />

        <RelativeLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <TextView
                android:id="@+id/chatToolbarAvatar"
                style="@style/Avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text=""
                android:textSize="13sp" />

            <View
                android:id="@+id/chatToolbarOnline"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/avatar_outline"
                android:visibility="gone" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatToolbarName"
                style="@style/Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="" />

            <TextView
                android:id="@+id/chatToolbarStatus"
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="" />

        </LinearLayout>

        <ImageView
            android:id="@+id/callButton"
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:contentDescription="Voice call"
            android:padding="10dp"
            android:src="@drawable/ic_phone"
            android:tint="@color/primary" />

        <ImageView
            android:id="@+id/videoCallButton"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:contentDescription="Video call"
            android:padding="9dp"
            android:src="@drawable/ic_video"
            android:tint="@color/primary" />

        <ImageView
            android:id="@+id/chatInfoButton"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:contentDescription="Information"
            android:padding="9dp"
            android:src="@drawable/ic_info"
            android:tint="@color/primary" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingHorizontal="5dp">

        <TextView
            android:id="@+id/chatUploadStatus"
            style="@style/Meta"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:textColor="@color/primary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/chatReplyBar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chatReplyLabel"
                style="@style/Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/chatReplyCancel"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Cancel reply"
                android:padding="7dp"
                android:src="@drawable/ic_close" />

        </LinearLayout>

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="0dp">

        <ImageView
            android:id="@+id/chatAttachmentButton"
            android:layout_width="34dp"
            android:layout_height="42dp"
            android:padding="8dp"
            android:src="@drawable/ic_add"
            android:tint="@color/primary" />

        <ImageView
            android:id="@+id/chatCameraButton"
            android:layout_width="34dp"
            android:layout_height="42dp"
            android:padding="8dp"
            android:src="@drawable/ic_camera"
            android:tint="@color/primary" />

        <ImageView
            android:id="@+id/chatImageButton"
            android:layout_width="34dp"
            android:layout_height="42dp"
            android:padding="8dp"
            android:src="@drawable/ic_image"
            android:tint="@color/primary" />

        <ImageView
            android:id="@+id/chatVoiceButton"
            android:layout_width="34dp"
            android:layout_height="42dp"
            android:padding="8dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/input_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="13dp">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Aa"
                android:singleLine="true"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_smile"
                android:tint="@color/primary" />

        </LinearLayout>

        <ImageView
            android:id="@+id/sendMessageButton"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:padding="8dp"
            android:src="@drawable/ic_thumb_up"
            android:tint="@color/primary" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
