<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Back"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Comments"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="116dp"
            android:layout_height="38dp"
            android:background="@drawable/rounded_soft"
            android:gravity="center"
            android:paddingHorizontal="10dp">

            <TextView
                style="@style/Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Most relevant"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_down" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/reaction_like" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="-4dp"
            android:src="@drawable/reaction_love" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="-4dp"
            android:src="@drawable/reaction_laugh" />

        <TextView
            style="@style/Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="1.2K"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/sampleCommentsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top">

                <TextView
                    android:id="@+id/aishaCommentProfile"
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_red"
                    android:text="AK"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_soft"
                        android:padding="12dp"
                        android:text="Aisha Khan\nThat sky is unreal. Which part of the beach was this?"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp">

                        <TextView
                            style="@style/Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2h"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Like"
                            android:textColor="@color/primary"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Reply"
                            android:textSize="11sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="62dp"
                            android:layout_height="28dp"
                            android:background="@drawable/rounded_white"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/reaction_like" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="-3dp"
                                android:src="@drawable/reaction_love" />

                            <TextView
                                style="@style/Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:text="24" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="46dp"
                android:gravity="top">

                <TextView
                    android:id="@+id/linaCommentProfile"
                    style="@style/Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_purple"
                    android:text="LM"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_soft"
                        android:padding="11dp"
                        android:text="Lina Marsh\nNear the old pier, right before the rain started!"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="29dp"
                        android:gravity="center_vertical"
                        android:paddingStart="11dp">

                        <TextView
                            style="@style/Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Like"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Reply"
                            android:textSize="11sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="42dp"
                            android:layout_height="26dp"
                            android:background="@drawable/rounded_white"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/reaction_laugh" />

                            <TextView
                                style="@style/Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:text="3" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="46dp"
                android:gravity="top">

                <TextView
                    android:id="@+id/zainCommentProfile"
                    style="@style/Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_teal_mid"
                    android:text="ZR"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_soft"
                        android:padding="11dp"
                        android:text="Zain Raza\n@Lina Marsh next time invite the rest of us"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="29dp"
                        android:gravity="center_vertical"
                        android:paddingStart="11dp">

                        <TextView
                            style="@style/Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45m"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Like"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Reply"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginStart="82dp"
                android:gravity="center_vertical"
                android:text="View 6 more replies"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top">

                <TextView
                    android:id="@+id/hamzaCommentProfile"
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_green"
                    android:text="HA"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_soft"
                        android:padding="11dp"
                        android:text="Hamza Ali\nSame spot, one year ago:"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="190dp"
                        android:layout_height="132dp"
                        android:layout_marginTop="6dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/landscape_blue" />

                    <LinearLayout
                        android:layout_width="190dp"
                        android:layout_height="29dp"
                        android:gravity="center_vertical"
                        android:paddingStart="11dp">

                        <TextView
                            style="@style/Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Like"
                            android:textSize="11sp" />

                        <TextView
                            style="@style/Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Reply"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="top">

                <TextView
                    android:id="@+id/mayaCommentProfile"
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_green"
                    android:text="MC"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/rounded_soft"
                    android:padding="11dp"
                    android:text="Maya Chen\nFraming this one."
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/commentsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/replyingLabel"
                style="@style/Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Replying to Aisha Khan"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cancelReplyButton"
                style="@style/Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Camera"
                android:padding="8dp"
                android:src="@drawable/ic_camera"
                android:tint="@color/primary" />

            <EditText
                android:id="@+id/commentInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="7dp"
                android:layout_weight="1"
                android:background="@drawable/input_pill"
                android:hint="Write a reply..."
                android:paddingHorizontal="14dp"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/sendCommentButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_teal"
                android:contentDescription="Send"
                android:padding="11dp"
                android:src="@drawable/ic_send"
                android:tint="@color/white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
