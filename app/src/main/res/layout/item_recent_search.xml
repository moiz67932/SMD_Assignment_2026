<?xml version="1.0" encoding="utf-8"?>
<!-- A recent search in Search (13): clock icon, the text, and X to forget it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/circle_soft"
        android:contentDescription="Recent search"
        android:padding="8dp"
        android:src="@drawable/ic_history" />

    <TextView
        android:id="@+id/recentSearchText"
        style="@style/Body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/recentSearchRemove"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="Remove"
        android:padding="8dp"
        android:src="@drawable/ic_close" />

</LinearLayout>
