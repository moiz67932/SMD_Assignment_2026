<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:paddingStart="7dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/input_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:paddingHorizontal="8dp"
                android:singleLine="true"
                android:hint="Search people"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/searchClearButton"
                android:contentDescription="Clear search"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/circle_soft"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary" />

        </LinearLayout>

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipAll"
                style="@style/Heading"
                android:layout_width="52dp"
                android:layout_height="32dp"
                android:background="@drawable/rounded_teal_soft"
                android:gravity="center"
                android:text="All"
                android:textColor="@color/primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipPeople"
                style="@style/Heading"
                android:layout_width="68dp"
                android:layout_height="32dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/rounded_soft"
                android:gravity="center"
                android:text="People"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipPosts"
                style="@style/Heading"
                android:layout_width="62dp"
                android:layout_height="32dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/rounded_soft"
                android:gravity="center"
                android:text="Posts"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipGroups"
                style="@style/Heading"
                android:layout_width="66dp"
                android:layout_height="32dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/rounded_soft"
                android:gravity="center"
                android:text="Groups"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipMarketplace"
                style="@style/Heading"
                android:layout_width="94dp"
                android:layout_height="32dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/rounded_soft"
                android:gravity="center"
                android:text="Marketplace"
                android:textSize="11sp" />

        </LinearLayout>

    </HorizontalScrollView>


    <TextView
        android:id="@+id/searchSectionTitle"
        style="@style/Heading"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:text="Recent searches"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/recentSearchesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp" />

    <TextView
        android:id="@+id/searchEmpty"
        style="@style/Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp" />

</LinearLayout>
