<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.32"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <Space
                android:layout_width="40dp"
                android:layout_height="1dp" />

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/reactionToolbarTitle"
                android:text=""
                android:textSize="20sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="122dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/reactionAuthorButton"
                    style="@style/Avatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/circle_purple"
                    android:text="" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/reactionAuthorName"
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/reactionPostTime"
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/reactionPostText"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="14sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/reactionPostImage"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:scaleType="centerCrop"
            android:background="@drawable/media_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/reactionSummary1"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Reaction" />

            <ImageView
                android:id="@+id/reactionSummary2"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="-3dp"
                android:contentDescription="Reaction" />

            <ImageView
                android:id="@+id/reactionSummary3"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="-3dp"
                android:contentDescription="Reaction" />

            <TextView
                android:id="@+id/reactionSummaryText"
                style="@style/Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="" />

            <TextView
                android:id="@+id/reactionCommentCount"
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_thumb_up"
                    android:tint="@color/primary" />

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Like"
                    android:textColor="@color/primary" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_comment" />

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Comment" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_share" />

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Share" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:background="@color/divider" />

        <TextView
            style="@style/Heading"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:id="@+id/reactionMostRelevant"
            android:text="Most relevant" />

        <LinearLayout
            android:id="@+id/reactionSampleComment"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/reactionCommenterButton"
                style="@style/Avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:text=""
                android:textSize="12sp" />

            <TextView
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:background="@drawable/rounded_soft"
                android:padding="11dp"
                android:id="@+id/reactionCommentText"
                android:text="" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="5dp"
        android:contentDescription="Back"
        android:padding="12dp"
        android:src="@drawable/ic_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:translationY="45dp">

        <TextView
            style="@style/Meta"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:id="@+id/reactionTooltip"
            android:visibility="invisible"
            android:background="@drawable/rounded_black"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text=""
            android:textColor="@color/white"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="-2dp"
            android:background="@drawable/rounded_white"
            android:gravity="center"
            android:paddingHorizontal="7dp">

            <ImageView
                android:id="@+id/reactionLike"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="Like"
                android:src="@drawable/reaction_like" />

            <ImageView
                android:id="@+id/reactionLove"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="Love"
                android:src="@drawable/reaction_love" />

            <ImageView
                android:id="@+id/reactionLaugh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="Laugh"
                android:src="@drawable/reaction_laugh" />

            <ImageView
                android:id="@+id/reactionWow"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="Wow"
                android:src="@drawable/reaction_wow" />

            <ImageView
                android:id="@+id/reactionSad"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="Sad"
                android:src="@drawable/reaction_sad" />

            <ImageView
                android:id="@+id/reactionAngry"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="Angry"
                android:src="@drawable/reaction_angry" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
