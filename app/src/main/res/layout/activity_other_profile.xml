<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="7dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/otherToolbarName"
                style="@style/Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kinnect member" />

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Search"
                android:padding="9dp"
                android:src="@drawable/ic_search" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/landscape_dark" />

            <TextView
                android:id="@+id/otherProfileAvatar"
                style="@style/Avatar"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/avatar_outline"
                android:text="OF"
                android:textSize="34sp" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/otherProfileName"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Kinnect member"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/otherProfileStats"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="1,204 friends · 38 mutual" />

            <TextView
                android:id="@+id/otherProfileBio"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Night photographer. Karachi after dark." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="11dp">

                <LinearLayout
                    android:id="@+id/friendActionButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_teal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_person_add"
                        android:tint="@color/white" />

                    <TextView
                        android:id="@+id/friendActionLabel"
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Add friend"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/messageButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_soft"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chat" />

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Message"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/rounded_soft"
                    android:padding="11dp"
                    android:src="@drawable/ic_more" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="28dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/aishaMutualFriendButton"
                        style="@style/Avatar"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/circle_red"
                        android:text="AK"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/linaMutualFriendButton"
                        style="@style/Avatar"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="-5dp"
                        android:background="@drawable/circle_purple"
                        android:text="LM"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/zainMutualFriendButton"
                        style="@style/Avatar"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="-5dp"
                        android:background="@drawable/circle_teal_mid"
                        android:text="ZR"
                        android:textSize="8sp" />

                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:id="@+id/otherMutualFriendNames"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="11sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_work"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/otherProfileWork"
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Photographer at Studio Nocturne" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/otherProfileLocation"
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Lives in Karachi, Pakistan" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/otherProfileJoined"
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Joined June 2017" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Photos"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/landscape_dark" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/landscape_purple" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/landscape_blue" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
