<?xml version="1.0" encoding="utf-8"?>
<!-- One person in Friends (14): a request (Confirm/Delete), a suggestion (Add friend/Remove) or a friend (no buttons). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="7dp">

    <TextView
        android:id="@+id/friendAvatar"
        style="@style/Avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/circle_purple"
        android:textSize="19sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/friendName"
                style="@style/Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/friendTime"
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/friendMutual1"
                style="@style/Avatar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:textSize="6sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/friendMutual2"
                style="@style/Avatar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="-4dp"
                android:background="@drawable/circle_purple"
                android:textSize="6sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/friendSubtitle"
                style="@style/Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/friendRequestActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/confirmFriendRequest"
                style="@style/TealButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="Confirm"
                android:textSize="11sp" />

            <Button
                android:id="@+id/deleteFriendRequest"
                style="@style/LightButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
