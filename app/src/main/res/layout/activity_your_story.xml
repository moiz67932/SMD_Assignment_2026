<?xml version="1.0" encoding="utf-8"?>
<!-- Your story (12): my active stories with who has seen them. Filled by YourStoryActivity. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/storyImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/yourStoryBar"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_dark"
        android:contentDescription="Story"
        android:scaleType="centerCrop" />

    <VideoView
        android:id="@+id/storyVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/yourStoryBar"
        android:layout_centerInParent="true"
        android:layout_margin="8dp"
        android:visibility="gone" />

    <View
        android:id="@+id/storyTouch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/yourStoryBar" />

    <LinearLayout
        android:id="@+id/storySegments"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/storyAvatar"
            style="@style/Avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your story"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/storyMeta"
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" />

        </LinearLayout>

        <ImageView
            android:id="@+id/doneButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Close"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:tint="@color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/storyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/rounded_red"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:rotation="4"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Hearts float up for each Love reaction viewers sent on this story. -->
    <LinearLayout
        android:id="@+id/yourHearts"
        android:layout_width="42dp"
        android:layout_height="190dp"
        android:layout_above="@id/yourStoryBar"
        android:layout_marginStart="34dp"
        android:layout_marginBottom="20dp"
        android:gravity="bottom"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/yourEmpty"
        style="@style/Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="32dp"
        android:text="Loading your story…"
        android:textColor="@color/white"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/yourStoryBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="#CC000000"
        android:gravity="center"
        android:paddingHorizontal="7dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/yourSeenBy"
            android:layout_weight="1.15"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:id="@+id/yourSeen1"
                    android:visibility="gone"
                    android:text=""
                    android:textSize="7sp" />

                <TextView
                    style="@style/Avatar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="-5dp"
                    android:id="@+id/yourSeen2"
                    android:visibility="gone"
                    android:text=""
                    android:textSize="7sp" />

                <TextView
                    style="@style/Avatar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="-5dp"
                    android:id="@+id/yourSeen3"
                    android:visibility="gone"
                    android:text=""
                    android:textSize="7sp" />

            </LinearLayout>

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:id="@+id/yourSeenCount"
                android:text="No views yet"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/yourCreateButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_image"
                android:tint="@color/white" />

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Create"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/yourHighlightButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bookmark"
                android:tint="@color/white" />

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Highlight"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/yourSendButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_send"
                android:tint="@color/white" />

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Send"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/yourMoreButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_more"
                android:tint="@color/white" />

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="More"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
