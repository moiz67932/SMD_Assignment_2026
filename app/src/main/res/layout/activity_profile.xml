<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="7dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/profileToolbarName"
                style="@style/Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Search"
                android:padding="9dp"
                android:src="@drawable/ic_search" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="232dp">

            <ImageView
                android:id="@+id/profileCoverImage"
                android:layout_width="match_parent"
                android:layout_height="174dp"
                android:contentDescription="Cover photo"
                android:scaleType="centerCrop"
                android:background="@color/teal_soft" />

            <ImageView
                android:id="@+id/profileCoverCamera"
                android:contentDescription="Change cover photo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="138dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/circle_white"
                android:padding="8dp"
                android:src="@drawable/ic_camera" />

            <TextView
                android:id="@+id/profileAvatar"
                style="@style/Avatar"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:background="@drawable/avatar_outline"
                android:gravity="center"
                android:text=""
                android:textSize="34sp" />

            <ImageView
                android:id="@+id/profileAvatarCamera"
                android:contentDescription="Change profile picture"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="94dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/circle_white"
                android:padding="8dp"
                android:src="@drawable/ic_camera" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/profileDisplayName"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="23sp" />

            <TextView
                android:id="@+id/profileFriendCount"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 friends"
                android:textSize="11sp" />

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:id="@+id/profileDisplayBio"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:id="@+id/addStoryButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_teal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_add"
                        android:tint="@color/white" />

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Add to story"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_soft"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_edit" />

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Edit profile"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/rounded_soft"
                    android:padding="11dp"
                    android:src="@drawable/ic_more" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Heading"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:background="@drawable/rounded_teal_soft"
                    android:gravity="center"
                    android:text="Posts"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />

                <TextView
                    style="@style/Heading"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Photos"
                    android:textSize="11sp" />

                <TextView
                    style="@style/Heading"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Videos"
                    android:textSize="11sp" />

                <TextView
                    style="@style/Heading"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Groups"
                    android:textSize="11sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profilePostsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/profilePostsEmpty"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="No posts yet"
                android:visibility="gone" />

            <TextView
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="Details"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/profileBirthdayRow"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/text_secondary" />

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:id="@+id/profileBirthdayValue"
                    android:text="" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileGenderRow"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_friends"
                    android:tint="@color/text_secondary" />

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:id="@+id/profileGenderValue"
                    android:text="" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileLocationRow"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/text_secondary" />

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileJoinedRow"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/text_secondary" />

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:id="@+id/profileJoinedValue"
                    android:text="" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friends"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/profileFriendsCountBottom"
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 friends" />

                </LinearLayout>

                <TextView
                    style="@style/Heading"
                    android:id="@+id/findFriendsFromProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find friends"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="152dp">

                <TextView
                    android:id="@+id/linaFriendButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/photo_purple"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/aishaFriendButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/photo_red"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/omarFriendButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/photo_green"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="30sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
