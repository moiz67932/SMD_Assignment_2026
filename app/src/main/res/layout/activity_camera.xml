<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_dark"
            android:contentDescription="Camera"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/cameraHint"
            style="@style/Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="Tap the shutter for a photo\nHold it for a video (up to 30 s)"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/cameraSettingsButton"
            android:alpha="0.45"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="14dp"
            android:background="@drawable/circle_dark"
            android:contentDescription="Flash"
            android:padding="11dp"
            android:src="@drawable/ic_flash"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_margin="14dp"
            android:background="@drawable/circle_dark"
            android:contentDescription="Close"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/galleryButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/circle_dark"
                android:contentDescription="Gallery"
                android:padding="10dp"
                android:src="@drawable/ic_image"
                android:tint="@color/white" />

            <ImageView
                android:alpha="0.45"
                android:id="@+id/cameraFlashButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/circle_dark"
                android:contentDescription="Flash"
                android:padding="11dp"
                android:src="@drawable/ic_flash"
                android:tint="@color/white" />

            <RelativeLayout
                android:id="@+id/shutterButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/circle_soft">

                <View
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/circle_white" />

            </RelativeLayout>

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/circle_dark"
                android:contentDescription="Switch camera"
                android:padding="10dp"
                android:src="@drawable/ic_rotate"
                android:id="@+id/cameraSwitchButton"
                android:alpha="0.45"
                android:tint="@color/white" />

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/circle_dark"
                android:contentDescription="Effects"
                android:padding="10dp"
                android:src="@drawable/ic_smile"
                android:id="@+id/cameraEffectsButton"
                android:alpha="0.45"
                android:tint="@color/white" />

        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:id="@+id/modeText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeTextLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TEXT"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modeTextLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/modeLive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeLiveLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="LIVE"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modeLiveLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/modeStory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeStoryLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="STORY"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modeStoryLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/modePost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modePostLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="POST"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modePostLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/modeBoomerang"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeBoomerangLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="BOOMERANG"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modeBoomerangLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
