<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notifications" />

        <ImageView
            android:id="@+id/searchButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Search"
            android:padding="9dp"
            android:src="@drawable/ic_search" />

        <ImageView
            android:id="@+id/chatsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Chats"
            android:padding="9dp"
            android:src="@drawable/ic_chat" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/homeTab"
            style="@style/Tab"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/friendsTab"
            style="@style/Tab"
            android:contentDescription="Friends"
            android:src="@drawable/ic_friends" />

        <ImageView
            android:id="@+id/marketTab"
            style="@style/Tab"
            android:contentDescription="Marketplace"
            android:src="@drawable/ic_marketplace" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_notifications"
                android:tint="@color/primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="9dp"
                android:background="@color/primary" />

        </LinearLayout>

        <ImageView
            android:id="@+id/menuTab"
            style="@style/Tab"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/sampleNotificationsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="New"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/aishaNotificationProfile"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:background="@color/teal_soft"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_red"
                    android:text="AK"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aisha Khan and 32 others reacted to your photo." />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="5m"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_more" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/saraNotificationProfile"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:background="@color/teal_soft"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_purple"
                    android:text="SI"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sara Iqbal sent you a friend request." />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="20m"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp">

                        <Button
                            style="@style/TealButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:text="Confirm"
                            android:textSize="11sp" />

                        <Button
                            style="@style/LightButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="7dp"
                            android:layout_weight="1"
                            android:text="Delete"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Earlier"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/zainNotificationProfile"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_teal_mid"
                    android:text="ZR"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Zain Raza replied to your comment: “next time invite the rest of us”" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2h" />

                </LinearLayout>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_more" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_green"
                    android:text="DC"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="New post in SMD Class of 2026: “Assignment 1 is out. Start early.”" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5h" />

                </LinearLayout>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_more" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/hamzaNotificationProfile"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_green"
                    android:text="HA"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hamza Ali tagged you in a post." />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yesterday" />

                </LinearLayout>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_more" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linaNotificationProfile"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_purple"
                    android:text="LM"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lina Marsh liked your story." />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2d" />

                </LinearLayout>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_more" />

            </LinearLayout>

            <Button
                style="@style/LightButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginVertical="10dp"
                android:text="See previous notifications"
                android:textSize="11sp" />

        </LinearLayout>

    </ScrollView>

    <ScrollView
        android:id="@+id/notificationsContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/newNotificationsHeading"
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="New"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/newNotificationsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/earlierNotificationsHeading"
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Earlier"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/earlierNotificationsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/notificationsEmpty"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="center"
                android:text="No notifications yet"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
