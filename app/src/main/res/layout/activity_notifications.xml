<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notifications" />

        <ImageView
            android:id="@+id/searchButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Search"
            android:padding="9dp"
            android:src="@drawable/ic_search" />

        <ImageView
            android:id="@+id/chatsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Chats"
            android:padding="9dp"
            android:src="@drawable/ic_chat" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/homeTab"
            style="@style/Tab"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/friendsTab"
            style="@style/Tab"
            android:contentDescription="Friends"
            android:src="@drawable/ic_friends" />

        <ImageView
            android:id="@+id/marketTab"
            style="@style/Tab"
            android:contentDescription="Marketplace"
            android:src="@drawable/ic_marketplace" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_notifications"
                android:tint="@color/primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="9dp"
                android:background="@color/primary" />

        </LinearLayout>

        <ImageView
            android:id="@+id/menuTab"
            style="@style/Tab"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />


    <ScrollView
        android:id="@+id/notificationsContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/newNotificationsHeading"
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="New"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/newNotificationsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/earlierNotificationsHeading"
                style="@style/Heading"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Earlier"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/earlierNotificationsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/notificationsEmpty"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="center"
                android:text="No notifications yet"
                android:visibility="gone" />

            <TextView
                android:id="@+id/olderNotificationsButton"
                style="@style/LightButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginVertical="12dp"
                android:gravity="center"
                android:text="See previous notifications"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
