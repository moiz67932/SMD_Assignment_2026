<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Create account" />

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 2 of 3" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@color/primary" />

            <Space
                android:layout_width="6dp"
                android:layout_height="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@color/primary" />

            <Space
                android:layout_width="6dp"
                android:layout_height="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@color/divider" />

        </LinearLayout>

        <TextView
            style="@style/Title"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="-2dp"
            android:text="What’s your name and birthday?" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp">

            <EditText
                android:id="@+id/firstNameInput"
                style="@style/Input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="First name"
                android:text="" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/lastNameInput"
                style="@style/Input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Last name"
                android:text="" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <TextView
                style="@style/Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Birthday" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:contentDescription="Birthday information"
                android:src="@drawable/ic_info"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/birthdayDayButton"
                style="@style/LightButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="start|center_vertical"
                android:text="Choose day" />

            <Space
                android:layout_width="7dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/birthdayMonthButton"
                style="@style/LightButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="start|center_vertical"
                android:text="Choose month" />

            <Space
                android:layout_width="7dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/birthdayYearButton"
                style="@style/LightButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="start|center_vertical"
                android:text="Choose year" />

        </LinearLayout>

        <TextView
            style="@style/Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Gender" />

        <RadioGroup
            android:id="@+id/genderGroup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/genderFemale"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:buttonTint="@color/primary"
                android:gravity="center"
                android:text="Female"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/genderMale"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="7dp"
                android:layout_weight="1"
                android:background="@drawable/outline_teal"
                android:buttonTint="@color/primary"
                android:checked="true"
                android:gravity="center"
                android:text="Male"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/genderCustom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:buttonTint="@color/primary"
                android:gravity="center"
                android:text="Custom"
                android:textSize="12sp" />

        </RadioGroup>

        <EditText
            android:id="@+id/signupEmailInput"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="9dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:text="" />

        <EditText
            android:id="@+id/signupPasswordInput"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="9dp"
            android:drawableEnd="@drawable/ic_visibility"
            android:hint="New password"
            android:inputType="textPassword"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/strengthBar1"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@color/divider" />

            <Space
                android:layout_width="5dp"
                android:layout_height="3dp" />

            <View
                android:id="@+id/strengthBar2"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@color/divider" />

            <Space
                android:layout_width="5dp"
                android:layout_height="3dp" />

            <View
                android:id="@+id/strengthBar3"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="@color/divider" />

        </LinearLayout>

        <TextView
            android:id="@+id/passwordStrengthLabel"
            style="@style/Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Enter a password"
            android:textColor="@color/text_secondary" />

        <CheckBox
            android:id="@+id/termsCheckbox"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="@color/primary"
            android:checked="true"
            android:text="I agree to the Kinnect Terms and Privacy Policy."
            android:textSize="10sp" />

        <Button
            android:id="@+id/createAccountButton"
            style="@style/TealButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Create account" />

        <TextView
            android:id="@+id/loginLink"
            style="@style/Meta"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Already have an account?  Log in" />

    </LinearLayout>

</ScrollView>
