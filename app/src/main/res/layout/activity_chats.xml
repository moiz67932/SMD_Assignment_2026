<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:paddingStart="7dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chats" />

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Compose"
            android:padding="9dp"
            android:src="@drawable/ic_edit" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="14dp"
        android:background="@drawable/input_pill"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_search"
            android:tint="@color/text_secondary" />

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:text="Search"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/circle_soft"
                    android:padding="12dp"
                    android:src="@drawable/ic_add" />

                <TextView
                    style="@style/Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your note" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/circle_red"
                    android:text="AK"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Aisha" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/circle_green"
                    android:text="OF"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Omar" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/circle_purple"
                    android:text="SI"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sara" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/circle_green"
                    android:text="HA"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hamza" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/sampleChatsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:id="@+id/chatButton"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/circle_red"
                    android:text="AK"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aisha Khan"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sending the photos tonight · 2m"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/circle_teal" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/designCrewChatButton"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/circle_green"
                    android:text="DC"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Design crew"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maya: the new mockups look clean · 15m"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/circle_teal" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linaChatButton"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/circle_purple"
                    android:text="LM"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lina Marsh"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You: See you at the pier · 1h" />

                </LinearLayout>

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/circle_red" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/omarChatButton"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/circle_green"
                    android:text="OF"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Omar Farooq"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Haha that story was wild · 3h" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bilalChatButton"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/circle_purple"
                    android:text="BA"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bilal Ahmed"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thanks, bro! · Mon" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/noorChatButton"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Avatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/circle_green"
                    android:text="NF"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Noor Fatima"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You: Happy birthday! · Sun" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chat"
                android:tint="@color/primary" />

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Chats"
                android:textColor="@color/primary"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_friends" />

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="People" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_video" />

            <TextView
                style="@style/Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Stories" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
