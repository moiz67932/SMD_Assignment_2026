<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="kinnect"
            android:textColor="@color/primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/searchButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Search"
            android:padding="9dp"
            android:src="@drawable/ic_search" />

        <ImageView
            android:id="@+id/chatsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="Chats"
            android:padding="9dp"
            android:src="@drawable/ic_chat" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/white"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:tint="@color/primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="9dp"
                android:background="@color/primary" />

        </LinearLayout>

        <ImageView
            android:id="@+id/friendsTab"
            style="@style/Tab"
            android:contentDescription="Friends"
            android:src="@drawable/ic_friends" />

        <ImageView
            android:id="@+id/marketTab"
            style="@style/Tab"
            android:contentDescription="Marketplace"
            android:src="@drawable/ic_marketplace" />

        <ImageView
            android:id="@+id/notificationsTab"
            style="@style/Tab"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_notifications" />

        <ImageView
            android:id="@+id/menuTab"
            style="@style/Tab"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/profileButton"
                    style="@style/Avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text=""
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/createPostButton"
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_pill"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="15dp"
                    android:text=""
                    android:textColor="@color/text_secondary" />

                <ImageView
                    android:id="@+id/photoShortcutButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="Choose a photo"
                    android:padding="8dp"
                    android:src="@drawable/ic_image"
                    android:tint="@color/primary" />

            </LinearLayout>


            <!-- Stories row: "Create story" first, then my story and friends' active stories (StoryRowAdapter). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/storiesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="158dp"
                android:layout_marginTop="7dp"
                android:background="@color/white"
                android:clipToPadding="false"
                android:padding="8dp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/feedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/feedEmpty"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="40dp"
                android:text="Loading your feed…" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
