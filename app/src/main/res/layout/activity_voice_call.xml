<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary">

    <FrameLayout
        android:id="@+id/callVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_alignParentTop="true"
        android:background="@color/text_primary"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/remoteVideoContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/localVideoContainer"
            android:layout_width="104dp"
            android:layout_height="150dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="28dp"
        android:gravity="center">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_lock"
            android:tint="#B8D9D9" />

        <TextView
            style="@style/Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.08"
            android:text="End-to-end encrypted"
            android:textColor="#B8D9D9" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:translationY="-25dp">

        <RelativeLayout
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:background="@drawable/circle_call_outer">

            <RelativeLayout
                android:layout_width="164dp"
                android:layout_height="164dp"
                android:layout_centerInParent="true"
                android:background="@drawable/circle_call_inner">

                <TextView
                    android:id="@+id/callAvatar"
                    android:layout_width="138dp"
                    android:layout_height="138dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/rounded_purple"
                    android:gravity="center"
                    android:text="AK"
                    android:textColor="@color/white"
                    android:textSize="46sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="22dp"
            android:gravity="center">

            <TextView
                android:id="@+id/callName"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kinnect member"
                android:textColor="@color/white"
                android:textSize="26sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/reaction_love" />

        </LinearLayout>

        <TextView
            android:id="@+id/callStatusText"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Connecting…"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/callDuration"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:paddingHorizontal="14dp">

        <ImageView
            android:id="@+id/cameraToggleButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_teal_mid"
            android:contentDescription="Keypad"
            android:padding="16dp"
            android:src="@drawable/ic_grid"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/muteButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/circle_teal_mid"
            android:contentDescription="Mute"
            android:padding="16dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/endCallButton"
            android:layout_width="70dp"
            android:layout_height="62dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/circle_red"
            android:contentDescription="End call"
            android:padding="18dp"
            android:rotation="135"
            android:src="@drawable/ic_phone"
            android:tint="@color/white" />

        <ImageView
            android:id="@+id/speakerButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_teal_mid"
            android:contentDescription="Speaker"
            android:padding="16dp"
            android:src="@drawable/ic_volume"
            android:tint="@color/white" />

    </LinearLayout>

</RelativeLayout>
