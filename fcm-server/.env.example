# Copy to .env (git-ignored) and fill in.
# Path to the service account key downloaded from
# Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the key in this folder as serviceAccountKey.json (also git-ignored) or anywhere outside the repo.
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Realtime Database URL from the Firebase console (Realtime Database > Data, top of the page).
DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
